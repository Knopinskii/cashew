# Everything the image must not carry.
#
# Secrets first: .env holds SECRET_KEY and database credentials, and anything
# baked into an image travels with it to every machine that pulls it.
.env
.env.*

# The local database. Copying it in would ship one developer's data as part of
# the application, and shadow the real one at runtime.
**/db.sqlite3

# Built on the host, for the host. A macOS virtualenv is useless in a Linux
# image, and node_modules is hundreds of megabytes the API never reads.
.venv/
venv/
**/node_modules/
**/__pycache__/
**/*.pyc

# Regenerated inside the image by collectstatic.
api/staticfiles/
app/dist/

# History and tooling the runtime has no use for.
.git/
.github/
.claude/
**/.DS_Store
