# Copy this file to .env and fill in real values. Never commit .env.

# Required. Generate one with:
# uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# True only on your own machine. Leave False (or remove) in production.
DEBUG=True

# Comma-separated, no spaces. Backend domains.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, no spaces. Frontend addresses, with http(s):// and no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Without it Django uses SQLite (api/db.sqlite3).
# DATABASE_URL=postgres://user:password@localhost:5432/cashew
