# Copy to .env and fill in. .env is gitignored; this file is not.

# Generate a new one, never reuse this placeholder:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-new-one

# Anything but true/1/yes/on counts as off. Never true in production.
DEBUG=True

# Comma-separated. Domains the backend answers to.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated. Frontend origins allowed to call the API, scheme included.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
